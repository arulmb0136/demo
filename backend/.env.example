# =========================================================================
# FastAPI Application Configuration
# =========================================================================
APP_NAME="Ironclad Contract Hub API"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# CORS Origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Centralized Logging
LOG_LEVEL="INFO"
LOG_FORMAT="colored"

# Security & JWT Authentication
SECRET_KEY="ironclad_super_secret_jwt_key_change_in_production_2026_xyz!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================================================================
# PostgreSQL Database (ONLY for Users, Roles & Permissions)
# NOTE: Contracts and documents are NEVER stored in this database.
# =========================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ironclad_db"

# =========================================================================
# Ironclad Live API Credentials (developer.ironcladapp.com)
# Supply your Client ID and Client Secret. The system automatically
# negotiates the OAuth2 access token and handles background refresh.
# =========================================================================
IRONCLAD_API_BASE_URL="https://ironcladapp.com"
IRONCLAD_TOKEN_URL="https://ironcladapp.com/oauth/token"
IRONCLAD_CLIENT_ID=""
IRONCLAD_CLIENT_SECRET=""

# Alternative aliases:
# CLIENT_ID=""
# CLIENT_SECRET=""
