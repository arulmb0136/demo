# =========================================================================
# FastAPI Application Configuration
# =========================================================================
APP_NAME="Ironclad Contract Hub API"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# CORS Origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Centralized Logging
LOG_LEVEL="INFO"
LOG_FORMAT="colored"

# Security & JWT Authentication
SECRET_KEY="ironclad_super_secret_jwt_key_change_in_production_2026_xyz!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================================================================
# Database (ONLY for Users, Roles & Permissions - Zero Contract Storage)
# For quick local run on Mac without Postgres, you can use SQLite:
# DATABASE_URL="sqlite:///./ironclad_dev.db"
# Or local PostgreSQL:
# =========================================================================
DATABASE_URL="sqlite:///./ironclad_dev.db"

# =========================================================================
# Ironclad Live API Credentials (developer.ironcladapp.com)
# =========================================================================
# FOR SANDBOX MODE (Use demo.ironcladapp.com):
IRONCLAD_API_BASE_URL="https://demo.ironcladapp.com/public/api/v1"
IRONCLAD_TOKEN_URL="https://demo.ironcladapp.com/oauth/token"
IRONCLAD_CLIENT_ID=""
IRONCLAD_CLIENT_SECRET=""

# FOR PRODUCTION MODE (Uncomment when switching to Prod):
# IRONCLAD_API_BASE_URL="https://ironcladapp.com/public/api/v1"
# IRONCLAD_TOKEN_URL="https://ironcladapp.com/oauth/token"

# Optional Actor Email (e.g. your Ironclad sandbox account email)
IRONCLAD_AS_USER_EMAIL=""

# SSL Verification (Set to false if running on Mac sandbox without local cert store)
VERIFY_SSL=True
