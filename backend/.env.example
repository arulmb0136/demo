# ==============================================================================
# FastAPI Backend Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=development
APP_NAME="Ironclad Contract Hub API"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173"

# Centralized Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored # options: colored, json

# JWT Authentication
SECRET_KEY=ironclad_super_secret_jwt_key_change_in_production_2026_xyz!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/ironclad_db
# For Docker Compose internal networking: postgresql://postgres:postgres@postgres:5432/ironclad_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ironclad_db

# Data Source Toggle: 'postgres' or 'ironclad'
DATA_SOURCE=postgres

# Ironclad API Configuration (developer.ironcladapp.com)
IRONCLAD_API_BASE_URL=https://ironcladapp.com/api/v1
IRONCLAD_CLIENT_ID=ironclad_demo_client_id
IRONCLAD_CLIENT_SECRET=ironclad_demo_client_secret
IRONCLAD_BEARER_TOKEN=demo_ironclad_bearer_token
IRONCLAD_DEMO_MODE=true

# AWS S3 / MinIO Storage Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ironclad-documents
S3_REGION=us-east-1
S3_USE_SSL=false
S3_MOCK_FALLBACK=true
