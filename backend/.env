# =========================================================================
# FastAPI Application Configuration
# =========================================================================
APP_NAME="Ironclad Contract Hub API"
ENVIRONMENT="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# CORS Origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Centralized Logging
LOG_LEVEL="INFO"
LOG_FORMAT="colored"

# Security & JWT Authentication (Local platform login)
SECRET_KEY="ironclad_super_secret_jwt_key_change_in_production_2026_xyz!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (ONLY for Users, Roles & Permissions - Zero Contract Storage)
DATABASE_URL="sqlite:///./ironclad_dev.db"

# =========================================================================
# Ironclad Live API Credentials - SANDBOX (demo.ironcladapp.com)
# =========================================================================
# Paste your Sandbox Client ID (UUID) and Client Secret below:
IRONCLAD_API_BASE_URL="https://demo.ironcladapp.com/public/api/v1"
IRONCLAD_TOKEN_URL="https://demo.ironcladapp.com/oauth/token"
IRONCLAD_CLIENT_ID="PASTE_YOUR_SANDBOX_CLIENT_ID_HERE"
IRONCLAD_CLIENT_SECRET="PASTE_YOUR_SANDBOX_CLIENT_SECRET_HERE"

# Optional Actor Email (e.g. your Ironclad sandbox account email)
IRONCLAD_AS_USER_EMAIL=""
